{
  "name": "europa-engine",
  "version": "0.1.0",
  "private": true,
  "description": "An experimental desktop workspace for Europa orbital and thermal research",
  "main": "electron/main.cjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 41837 --strictPort",
    "build:worker": "esbuild src/simulation/worker.ts --bundle --platform=node --format=cjs --outfile=dist-electron/worker.cjs",
    "dev": "npm run build:worker && concurrently -k \"npm:dev:web\" \"wait-on http://127.0.0.1:41837 && node electron/launch-dev.cjs\"",
    "build": "tsc --noEmit && vite build && esbuild src/simulation/worker.ts --bundle --platform=node --format=cjs --outfile=dist-electron/worker.cjs && esbuild src/simulation/gpuHardwareWorker.ts --bundle --platform=browser --format=iife --target=chrome130 --outfile=dist-electron/gpu-hardware-worker.js",
    "test": "vitest run",
    "test:gpu:hardware": "node electron/launch-gpu-hardware.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.74",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "org.europaengine.prototype",
    "productName": "Europa Engine",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "lubacareer <lubacareer@gmail.com>",
      "category": "Science"
    }
  }
}
